# ===== 数据层开关 =====
# 默认 mock 数据（无需任何凭据即可本地运行）
# 接入真实 Supabase 后：VITE_USE_MOCK=false，并填写以下两项
VITE_USE_MOCK=true

# ===== Supabase（可选，接入真实后端时填写）=====
# https://supabase.com/dashboard 新建项目后获取
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ===== AI 导师「水问」=====
# 学生自带 API Key：只在浏览器 localStorage 中保存，不上传服务器
# 平台密钥：配置在 Edge Function 环境变量中（supabase/functions/ai-mentor/.env.example）
VITE_AI_ENDPOINT=
